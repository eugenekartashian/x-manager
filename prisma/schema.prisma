// Data model draft: docs/architecture.md §2. Models are added task by task.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── App login (Better Auth core schema) ────────────────────────────────────

model User {
  id            String         @id
  name          String
  email         String         @unique
  emailVerified Boolean        @default(false)
  image         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sessions      Session[]
  accounts      Account[]
  workspace     Workspace?
  // App role (D-025). Superadmins also come from SUPERADMIN_EMAILS and are synced on sign-in.
  role          UserRole       @default(USER)
  invitesSent   AccessInvite[]

  @@map("user")
}

enum UserRole {
  USER
  SUPERADMIN
}

// Who may sign in (D-025). Email is stored normalized (trimmed, lower-case).
// Revoked invites are kept for the audit trail; re-inviting clears revokedAt.
model AccessInvite {
  id          String    @id @default(uuid(7))
  email       String    @unique
  invitedById String?
  invitedBy   User?     @relation(fields: [invitedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  @@index([invitedById])
  @@map("access_invite")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

// Login provider link (Google). Not the X account — see XAccount (M1.3).
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─── Tenancy ────────────────────────────────────────────────────────────────

// One workspace per user in the MVP (ownerId unique). Every user-owned row
// references a workspace and every query is scoped by workspaceId.
model Workspace {
  id        String   @id @default(uuid(7))
  ownerId   String   @unique
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  timezone  String   @default("Europe/Madrid")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Spend guard for paid X/AI calls (micro-dollars, per UTC calendar month). D-001.
  monthlyBudgetMicros       BigInt    @default(10000000)
  postsSyncedAt             DateTime?
  // A post is reposted at most once per interval (D-018); max 8 daily times, no daily cap.
  perPostMinIntervalMinutes Int       @default(120)
  // Reply assistant limits (D-020, user-configurable).
  replyCooldownHours        Int       @default(24)
  replyDailyLimit           Int       @default(15)
  // Per-user limits set by the superadmin (M6.3, D-026). Not applied to superadmins.
  limitListPosts            Int       @default(2)
  limitDailyTimes           Int       @default(4)
  limitTargets              Int       @default(3)
  limitTargetLoadsPerDay    Int       @default(3)
  limitAiIdeasPerTargetDay  Int       @default(5)
  targetsEnabled            Boolean   @default(true)
  // Collab messages a user may open in X per local day (M7.2, user decision: 30 for everyone).
  limitMessagesPerDay       Int       @default(30)
  aiEnabled                 Boolean   @default(true)

  xAccount        XAccount?
  usage           ExternalUsage[]
  billedResources BilledResource[]
  targets         TargetAccount[]
  candidates      CreatorCandidate[]
  trackedLinks    TrackedLink[]
  linkClicks      LinkClick[]
  replyTemplates  ReplyTemplate[]
  replies         ReplyLog[]
  posts           OwnPost[]
  schedule        RepostSchedule?
  slots           RepostSlot[]
  runs            ScheduledRepost[]
  featureUsage    FeatureUsage[]
  creatorEvents   CreatorEvent[]
  repostChecks    PromotedPostCheck[]

  @@map("workspace")
}

// ─── X account connection (M1.3) ────────────────────────────────────────────

enum XAccountStatus {
  CONNECTED
  NEEDS_RECONNECT
}

// One X account per workspace (MVP). Disconnecting deletes the row, so an X
// account can be connected again later — to this or another workspace.
// Tokens are AES-256-GCM encrypted (src/server/crypto.ts), bound to workspaceId.
model XAccount {
  id                   String         @id @default(uuid(7))
  workspaceId          String         @unique
  workspace            Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  xUserId              String         @unique
  username             String
  name                 String
  accessTokenEnc       String
  refreshTokenEnc      String
  accessTokenExpiresAt DateTime
  scopes               String
  status               XAccountStatus @default(CONNECTED)
  connectedAt          DateTime       @default(now())
  lastRefreshedAt      DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@map("x_account")
}

// ─── Cost accounting ────────────────────────────────────────────────────────

enum UsageProvider {
  X
  AI
}

// Estimated external spend per call. Money in micro-dollars ($0.010 = 10_000).
// Estimates only — the X Developer Console is the source of truth.
model ExternalUsage {
  id          String        @id @default(uuid(7))
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider    UsageProvider
  operation   String
  units       Int
  // Units X actually bills after its same-UTC-day deduplication (≤ units).
  billedUnits Int           @default(0)
  costMicros  BigInt
  occurredAt  DateTime      @default(now())

  @@index([workspaceId, occurredAt])
  @@map("external_usage")
}

// ─── Own posts & Repost rotation (M2.2) ─────────────────────────────────────

// The connected user's own posts, cached locally. Keyed by the X user id (not the
// XAccount row) so rotation survives a disconnect/reconnect of the same account.
model OwnPost {
  id               String            @id @default(uuid(7))
  workspaceId      String
  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  xUserId          String
  xPostId          String
  text             String
  postedAt         DateTime
  isPinned         Boolean           @default(false)
  likeCount        Int?
  repostCount      Int?
  replyCount       Int?
  impressionCount  Int?
  metricsUpdatedAt DateTime?
  // First attachment preview (photo URL or video/GIF thumbnail), pbs.twimg.com only.
  mediaType        String?
  mediaPreviewUrl  String?
  mediaCount       Int               @default(0)
  // Quote post: its media belongs to the quoted post, so there is no own preview.
  isQuote          Boolean           @default(false)
  quotedText       String?
  // Repost rotation: posts the user chose for scheduled Reposts, in order.
  inRotation       Boolean           @default(false)
  rotationPosition Int?
  lastRepostedAt   DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  slots            RepostSlot[]
  runs             ScheduledRepost[]

  @@unique([workspaceId, xPostId])
  @@index([workspaceId, xUserId, postedAt])
  @@index([workspaceId, xUserId, inRotation, rotationPosition])
  @@map("own_post")
}

// ─── Repost schedule (M2.3) ─────────────────────────────────────────────────

// One schedule per workspace (MVP): active between startDate and
// startDate + durationDays - 1 (local dates), or open-ended when durationDays is null.
model RepostSchedule {
  id               String       @id @default(uuid(7))
  workspaceId      String       @unique
  workspace        Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  active           Boolean      @default(false)
  startDate        String // YYYY-MM-DD
  durationDays     Int?
  // Express consent to automated Reposts on the user's behalf (X Developer Policy, D-030).
  // Required to switch the schedule on; the job ignores schedules without it.
  consentedAt      DateTime?
  // Last post taken from the repost list; the next "next from list" slot continues after it.
  listCursorPostId String?
  // Per-workspace processing lease: one worker handles a workspace at a time.
  processingUntil  DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  slots            RepostSlot[]

  @@map("repost_schedule")
}

enum SlotTarget {
  PINNED
  POST
  NEXT_FROM_LIST
}

// A daily time in its own timezone (e.g. 09:40 America/New_York) and what to repost.
model RepostSlot {
  id          String            @id @default(uuid(7))
  scheduleId  String
  schedule    RepostSchedule    @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  localTime   String // HH:MM, 24h
  timezone    String // IANA
  target      SlotTarget
  ownPostId   String?
  ownPost     OwnPost?          @relation(fields: [ownPostId], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())
  runs        ScheduledRepost[]

  @@index([workspaceId])
  @@index([scheduleId])
  @@map("repost_slot")
}

// ─── Repost execution (M2.4) ────────────────────────────────────────────────

enum RepostStatus {
  PROCESSING
  SUCCEEDED
  SKIPPED
  FAILED
  UNKNOWN // X did not confirm; not retried automatically (D-007)
}

enum AttemptStep {
  UNDO
  REPOST
  RECHECK
}

// One row per slot occurrence (slot + local date). Inserting the unique dedupeKey is
// the atomic claim: competing workers cannot execute the same occurrence twice.
model ScheduledRepost {
  id          String          @id @default(uuid(7))
  workspaceId String
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  slotId      String?
  slot        RepostSlot?     @relation(fields: [slotId], references: [id], onDelete: SetNull)
  dedupeKey   String          @unique
  runAt       DateTime
  localDate   String
  ownPostId   String?
  ownPost     OwnPost?        @relation(fields: [ownPostId], references: [id], onDelete: SetNull)
  xPostId     String? // snapshot, survives post deletion
  fromList    Boolean         @default(true)
  status      RepostStatus
  skipReason  String?
  errorCode   String?
  leaseUntil  DateTime?
  startedAt   DateTime        @default(now())
  finishedAt  DateTime?
  attempts    RepostAttempt[]

  @@index([workspaceId, runAt])
  @@index([status, leaseUntil])
  @@map("scheduled_repost")
}

model RepostAttempt {
  id                String          @id @default(uuid(7))
  scheduledRepostId String
  scheduledRepost   ScheduledRepost @relation(fields: [scheduledRepostId], references: [id], onDelete: Cascade)
  workspaceId       String
  step              AttemptStep
  outcome           String // ok | reposted | already_reposted | <error code>
  startedAt         DateTime
  finishedAt        DateTime

  @@index([scheduledRepostId])
  @@map("repost_attempt")
}

// X bills each read resource once per UTC day ("All resources are deduplicated within a
// 24-hour UTC day window" — docs.x.com pricing). One row per resource per day and workspace.
model BilledResource {
  id          String    @id @default(uuid(7))
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  day         String // YYYY-MM-DD (UTC)
  kind        String // "post" | "user"
  resourceId  String
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, day, kind, resourceId])
  @@map("billed_resource")
}

// ─── Reply assistant (M3) ───────────────────────────────────────────────────

// Niche accounts the user wants to reply to (added by @handle). Profile data is a
// snapshot from the last lookup. Replies are always posted by the user on x.com (D-008).
model TargetAccount {
  id                 String         @id @default(uuid(7))
  workspaceId        String
  workspace          Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  xUserId            String
  username           String
  name               String
  bio                String?
  avatarUrl          String? // pbs.twimg.com only
  verified           Boolean        @default(false)
  followersCount     Int?
  followingCount     Int?
  postsCount         Int?
  note               String?
  lastRepliedAt      DateTime?
  postsFetchedAt     DateTime?
  lookedUpAt         DateTime
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  // Collab CRM (M7.1, D-033).
  status             CreatorStatus  @default(NEW)
  tags               String[]       @default([])
  source             CreatorSource  @default(MANUAL)
  role               CreatorRole?
  lastContactAt      DateTime?
  // Collab CRM (M7.3): when they reposted our post (auto-check or by hand) and when we did back.
  theyRepostedAt     DateTime?
  repostedBackAt     DateTime?
  // Relationship with the connected account from X's connection_status at the last lookup
  // (null = unknown, e.g. added before D-036).
  followsYou         Boolean?
  youFollow          Boolean?
  // "Find similar" (D-038): where reading this creator's following list stopped
  // (X pagination token; null = start over) and whether the list was read to the end.
  followingCursor    String?
  followingExhausted Boolean        @default(false)
  posts              TargetPost[]
  replies            ReplyLog[]
  events             CreatorEvent[]

  @@unique([workspaceId, xUserId])
  @@index([workspaceId, followersCount])
  @@index([workspaceId, status])
  @@index([workspaceId, followsYou])
  @@map("target_account")
}

/// Where a creator is in the collaboration pipeline (set by the user; M7.3 adds automatic REPOSTED).
enum CreatorStatus {
  NEW // not contacted yet
  CONTACTED // message sent, waiting
  REPOSTED // they reposted our post
  PARTNER // ongoing collaboration
  DECLINED
  NO_REPLY
}

/// Creator's role in their content — set by the user, used to filter outreach.
enum CreatorRole {
  TOP
  BOTTOM
  VERSATILE
}

enum CreatorSource {
  MANUAL
  IMPORT
  SHARE
  DISCOVERY
}

// Latest posts of a target account, fetched on demand for a reply session.
model TargetPost {
  id              String        @id @default(uuid(7))
  workspaceId     String
  targetId        String
  target          TargetAccount @relation(fields: [targetId], references: [id], onDelete: Cascade)
  xPostId         String
  text            String
  postedAt        DateTime
  mediaType       String?
  mediaPreviewUrl String?
  mediaCount      Int           @default(0)
  likeCount       Int?
  replyCount      Int?
  impressionCount Int?
  // Set when the creator recently reposted this post of their own (it's shown as fresh then).
  repostedAt      DateTime?
  fetchedAt       DateTime

  @@unique([targetId, xPostId])
  @@index([workspaceId])
  @@map("target_post")
}

// The user's reply phrases; one is suggested at random in a reply session.
model ReplyTemplate {
  id          String    @id @default(uuid(7))
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  text        String
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
  @@map("reply_template")
}

enum ReplyStatus {
  OPENED // composer opened on x.com — counts toward the limits
  UNDONE // user said they did not post it
}

// A reply the user opened in X's composer. The app never posts replies itself (D-008).
model ReplyLog {
  id             String         @id @default(uuid(7))
  workspaceId    String
  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  targetId       String?
  target         TargetAccount? @relation(fields: [targetId], references: [id], onDelete: SetNull)
  targetUsername String
  xPostId        String
  text           String
  status         ReplyStatus    @default(OPENED)
  openedAt       DateTime
  undoneAt       DateTime?

  @@index([workspaceId, openedAt])
  @@index([targetId, openedAt])
  @@map("reply_log")
}

enum FeatureKind {
  TARGET_LOAD
  AI_IDEAS
  AI_MESSAGE
  REPOST_CHECK
}

// Counts limited actions per workspace-local day (M6.3): target post loads, AI idea requests.
model FeatureUsage {
  id          String      @id @default(uuid(7))
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  kind        FeatureKind
  targetId    String?
  occurredAt  DateTime    @default(now())

  @@index([workspaceId, kind, occurredAt])
  @@map("feature_usage")
}

// "Want to try" requests from the public landing page (D-032). Deleted when the superadmin
// invites or dismisses them, so only pending requests are stored.
model AccessRequest {
  id        String   @id @default(uuid(7))
  email     String   @unique
  xHandle   String?
  message   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("access_request")
}

enum CreatorEventKind {
  MESSAGE_OPENED // the user opened a prefilled DM in X (we can't see whether it was sent)
  STATUS_CHANGED
}

// Collab CRM history per creator (M7.2). Scoped by workspace; deleted with the creator.
model CreatorEvent {
  id          String           @id @default(uuid(7))
  workspaceId String
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  targetId    String
  target      TargetAccount    @relation(fields: [targetId], references: [id], onDelete: Cascade)
  kind        CreatorEventKind
  text        String?
  postUrl     String?
  status      CreatorStatus?
  undoneAt    DateTime?
  createdAt   DateTime         @default(now())

  @@index([workspaceId, kind, createdAt])
  @@index([targetId, createdAt])
  @@map("creator_event")
}

// Incremental "who reposted my post" checks (M7.3, D-033). X lists reposters newest first, so
// each check reads from the top and stops at accounts already seen → we pay only for new ones.
model PromotedPostCheck {
  id          String    @id @default(uuid(7))
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  xPostId     String
  seenIds     String[]  @default([]) // newest first, capped
  checkedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, xPostId])
  @@map("promoted_post_check")
}

/// "Find similar" suggestions (D-038): accounts a listed creator follows, waiting for Add/Skip.
/// Kept after Add/Skip so the same person is never suggested (or paid for twice by mistake).
model CreatorCandidate {
  id             String          @id @default(uuid(7))
  workspaceId    String
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  xUserId        String
  username       String
  name           String
  bio            String?
  avatarUrl      String? // pbs.twimg.com only
  verified       Boolean         @default(false)
  followersCount Int?
  followingCount Int?
  postsCount     Int?
  followsYou     Boolean?
  youFollow      Boolean?
  /// Username of the creator whose following list it came from.
  via            String
  status         CandidateStatus @default(PENDING)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([workspaceId, xUserId])
  @@index([workspaceId, status, followersCount])
  @@map("creator_candidate")
}

enum CandidateStatus {
  PENDING
  ADDED
  SKIPPED
}

/// Short tracked links (D-039): /l/<code> counts a click and redirects to `destinationUrl`.
model TrackedLink {
  id             String      @id @default(uuid(7))
  workspaceId    String
  workspace      Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  code           String      @unique
  label          String
  destinationUrl String
  archivedAt     DateTime?
  createdAt      DateTime    @default(now())
  clicks         LinkClick[]

  @@index([workspaceId, createdAt])
  @@map("tracked_link")
}

/// One human click (bots and link-preview crawlers are not stored). No IP is kept:
/// `visitorHash` is a per-day salted hash, only for counting unique visitors.
model LinkClick {
  id          String      @id @default(uuid(7))
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  linkId      String
  link        TrackedLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  clickedAt   DateTime    @default(now())
  country     String?
  device      String?
  visitorHash String

  @@index([linkId, clickedAt])
  @@index([workspaceId, clickedAt])
  @@map("link_click")
}
