// Data model draft: docs/architecture.md §2. Models are added task by task.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── App login (Better Auth core schema) ────────────────────────────────────

model User {
  id            String     @id
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false)
  image         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  sessions      Session[]
  accounts      Account[]
  workspace     Workspace?

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

// Login provider link (Google). Not the X account — see XAccount (M1.3).
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─── Tenancy ────────────────────────────────────────────────────────────────

// One workspace per user in the MVP (ownerId unique). Every user-owned row
// references a workspace and every query is scoped by workspaceId.
model Workspace {
  id        String   @id @default(uuid(7))
  ownerId   String   @unique
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  timezone  String   @default("Europe/Madrid")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Spend guard for paid X/AI calls (micro-dollars, per UTC calendar month). D-001.
  monthlyBudgetMicros       BigInt    @default(5000000)
  postsSyncedAt             DateTime?
  // Repost limits (D-003, D-012): a post is reposted at most once per interval;
  // at most dailyRepostCap Reposts per local day (hard ceiling in code).
  perPostMinIntervalMinutes Int       @default(240)
  dailyRepostCap            Int       @default(8)

  xAccount XAccount?
  usage    ExternalUsage[]
  posts    OwnPost[]
  schedule RepostSchedule?
  slots    RepostSlot[]

  @@map("workspace")
}

// ─── X account connection (M1.3) ────────────────────────────────────────────

enum XAccountStatus {
  CONNECTED
  NEEDS_RECONNECT
}

// One X account per workspace (MVP). Disconnecting deletes the row, so an X
// account can be connected again later — to this or another workspace.
// Tokens are AES-256-GCM encrypted (src/server/crypto.ts), bound to workspaceId.
model XAccount {
  id                   String         @id @default(uuid(7))
  workspaceId          String         @unique
  workspace            Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  xUserId              String         @unique
  username             String
  name                 String
  accessTokenEnc       String
  refreshTokenEnc      String
  accessTokenExpiresAt DateTime
  scopes               String
  status               XAccountStatus @default(CONNECTED)
  connectedAt          DateTime       @default(now())
  lastRefreshedAt      DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@map("x_account")
}

// ─── Cost accounting ────────────────────────────────────────────────────────

enum UsageProvider {
  X
  AI
}

// Estimated external spend per call. Money in micro-dollars ($0.010 = 10_000).
// Estimates only — the X Developer Console is the source of truth.
model ExternalUsage {
  id          String        @id @default(uuid(7))
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider    UsageProvider
  operation   String
  units       Int
  costMicros  BigInt
  occurredAt  DateTime      @default(now())

  @@index([workspaceId, occurredAt])
  @@map("external_usage")
}

// ─── Own posts & Repost rotation (M2.2) ─────────────────────────────────────

// The connected user's own posts, cached locally. Keyed by the X user id (not the
// XAccount row) so rotation survives a disconnect/reconnect of the same account.
model OwnPost {
  id               String       @id @default(uuid(7))
  workspaceId      String
  workspace        Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  xUserId          String
  xPostId          String
  text             String
  postedAt         DateTime
  isPinned         Boolean      @default(false)
  likeCount        Int?
  repostCount      Int?
  replyCount       Int?
  impressionCount  Int?
  metricsUpdatedAt DateTime?
  // First attachment preview (photo URL or video/GIF thumbnail), pbs.twimg.com only.
  mediaType        String?
  mediaPreviewUrl  String?
  mediaCount       Int          @default(0)
  // Repost rotation: posts the user chose for scheduled Reposts, in order.
  inRotation       Boolean      @default(false)
  rotationPosition Int?
  lastRepostedAt   DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  slots            RepostSlot[]

  @@unique([workspaceId, xPostId])
  @@index([workspaceId, xUserId, postedAt])
  @@index([workspaceId, xUserId, inRotation, rotationPosition])
  @@map("own_post")
}

// ─── Repost schedule (M2.3) ─────────────────────────────────────────────────

// One schedule per workspace (MVP): active between startDate and
// startDate + durationDays - 1 (local dates), or open-ended when durationDays is null.
model RepostSchedule {
  id               String       @id @default(uuid(7))
  workspaceId      String       @unique
  workspace        Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  active           Boolean      @default(false)
  startDate        String // YYYY-MM-DD
  durationDays     Int?
  // Last post taken from the repost list; the next "next from list" slot continues after it.
  listCursorPostId String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  slots            RepostSlot[]

  @@map("repost_schedule")
}

enum SlotTarget {
  PINNED
  POST
  NEXT_FROM_LIST
}

// A daily time in its own timezone (e.g. 09:40 America/New_York) and what to repost.
model RepostSlot {
  id          String         @id @default(uuid(7))
  scheduleId  String
  schedule    RepostSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  localTime   String // HH:MM, 24h
  timezone    String // IANA
  target      SlotTarget
  ownPostId   String?
  ownPost     OwnPost?       @relation(fields: [ownPostId], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())

  @@index([workspaceId])
  @@index([scheduleId])
  @@map("repost_slot")
}
