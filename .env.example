# Copy to .env.local and fill in. Never commit .env.local.
# Variables are validated in src/lib/env.ts as each milestone starts using them.

# --- Database (M1.1) ---
DATABASE_URL="postgresql://USER@localhost:5432/x_manager_dev"
TEST_DATABASE_URL="postgresql://USER@localhost:5432/x_manager_test"

# --- App login: Better Auth + Google (M1.2) ---
# Public base URL of the app (use 127.0.0.1 locally, not localhost)
APP_URL="http://127.0.0.1:3000"
# Session signing secret — generate: openssl rand -base64 32
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Comma-separated emails allowed to sign in
# Owner email(s), comma-separated: always allowed, superadmin. Others are invited in /admin.
SUPERADMIN_EMAILS=""

# --- X OAuth 2.0 (M1.3) — console.x.com → Apps → x-manager-personal → Keys & Tokens ---
X_CLIENT_ID=""
X_CLIENT_SECRET=""
X_REDIRECT_URI="http://127.0.0.1:3000/api/x/oauth/callback"
# Token encryption keys: "v1:<base64 32 bytes>[,v2:...]" — generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEYS=""
TOKEN_ENCRYPTION_CURRENT="v1"

# --- Scheduled jobs (M2) ---
# Shared secret for POST /api/jobs/run — generate: openssl rand -base64 32
# Optional: public contact email shown on /privacy and /terms.
LEGAL_CONTACT_EMAIL=""
# Optional: app-wide cap on estimated API spend per month, all users together (USD).
GLOBAL_MONTHLY_BUDGET_USD=""
CRON_SECRET=""
# Kill switch for real Reposts on X. Keep "false" (dry run) until you approve live Reposts.
X_WRITES_ENABLED="false"

# --- AI reply ideas (M3.4, optional; off without the chosen provider's key) ---
# "openai" (default model gpt-5-mini) or "anthropic" (default model claude-opus-5)
AI_PROVIDER="openai"
# Leave empty for the provider default
AI_MODEL=""
# platform.openai.com → API keys (Restricted: Responses = Write)
OPENAI_API_KEY=""
# console.anthropic.com → API keys
ANTHROPIC_API_KEY=""

# Error monitoring (optional; errors only, no personal data). Public DSN from Sentry → Project → Client Keys.
NEXT_PUBLIC_SENTRY_DSN=""
# Optional, build-time only: readable stack traces (source map upload).
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
